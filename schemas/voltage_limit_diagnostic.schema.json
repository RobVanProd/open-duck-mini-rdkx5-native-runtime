{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-duck-x5/voltage-limit-diagnostic.schema.json",
  "title": "Open Duck X5 torque-off model and voltage-limit diagnostic",
  "type": "object",
  "required": [
    "schema_version",
    "backend",
    "informational_only",
    "review_status",
    "hardware_gate_status",
    "run_status",
    "halt_reason",
    "finding",
    "read_order",
    "register_reads",
    "volts_per_count",
    "records",
    "complete_all14",
    "environment",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": "open_duck_x5.voltage_limit_diagnostic.v1" },
    "backend": { "enum": ["mock", "serial"] },
    "informational_only": { "type": "boolean" },
    "review_status": { "enum": ["INFORMATIONAL_ONLY", "REVIEW_REQUIRED"] },
    "hardware_gate_status": { "const": "NOT_ADVANCED_DIAGNOSTIC_ONLY" },
    "run_status": { "enum": ["COMPLETE", "HALTED"] },
    "halt_reason": { "type": ["string", "null"] },
    "finding": {
      "enum": ["incomplete_transport", "uniform_model_and_limits", "mixed_model_or_limits"]
    },
    "read_order": {
      "const": [20, 21, 22, 23, 24, 30, 31, 32, 33, 10, 11, 12, 14, 13]
    },
    "register_reads": {
      "const": [
        { "address": 3, "length": 2, "meaning": "model/version" },
        { "address": 14, "length": 2, "meaning": "maximum/minimum input voltage" }
      ]
    },
    "volts_per_count": { "const": 0.1 },
    "records": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "wire_index",
          "logical_index",
          "servo_id",
          "model_read",
          "voltage_limit_read",
          "model_raw",
          "model_low",
          "model_high",
          "max_voltage_raw",
          "max_voltage_v",
          "min_voltage_raw",
          "min_voltage_v"
        ],
        "properties": {
          "wire_index": { "type": "integer", "minimum": 0, "maximum": 13 },
          "logical_index": { "type": "integer", "minimum": 0, "maximum": 13 },
          "servo_id": { "enum": [20, 21, 22, 23, 24, 30, 31, 32, 33, 10, 11, 12, 13, 14] },
          "model_read": { "$ref": "#/$defs/read" },
          "voltage_limit_read": { "oneOf": [{ "$ref": "#/$defs/read" }, { "type": "null" }] },
          "model_raw": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
          "model_low": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
          "model_high": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
          "max_voltage_raw": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
          "max_voltage_v": { "type": ["number", "null"], "minimum": 0, "maximum": 25.5 },
          "min_voltage_raw": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
          "min_voltage_v": { "type": ["number", "null"], "minimum": 0, "maximum": 25.5 }
        },
        "additionalProperties": false
      }
    },
    "complete_all14": { "type": "boolean" },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform",
        "device",
        "baudrate",
        "timeout_ms",
        "repository_commit",
        "hardware_authorized",
        "suspended_or_benched"
      ],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "torque_enable_requested",
        "goal_position_write_count",
        "eeprom_write_count",
        "initial_torque_off_status",
        "final_torque_off_status"
      ],
      "properties": {
        "torque_enable_requested": { "const": false },
        "goal_position_write_count": { "const": 0 },
        "eeprom_write_count": { "const": 0 },
        "initial_torque_off_status": { "$ref": "#/$defs/status" },
        "final_torque_off_status": { "$ref": "#/$defs/status" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "status": {
      "enum": ["ok", "timeout", "crc", "partial", "device", "unexpected_id", "io"]
    },
    "read": {
      "type": "object",
      "required": [
        "address",
        "length",
        "response_status",
        "device_status_raw",
        "data",
        "response_length",
        "round_trip_ms"
      ],
      "properties": {
        "address": { "enum": [3, 14] },
        "length": { "const": 2 },
        "response_status": { "$ref": "#/$defs/status" },
        "device_status_raw": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "data": {
          "type": "array",
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "response_length": { "type": "integer", "minimum": 0 },
        "round_trip_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
