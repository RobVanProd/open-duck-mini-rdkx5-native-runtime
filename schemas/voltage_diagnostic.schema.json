{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-duck-x5/voltage-diagnostic.schema.json",
  "title": "Open Duck X5 torque-off voltage diagnostic",
  "type": "object",
  "required": [
    "schema_version",
    "backend",
    "informational_only",
    "review_status",
    "hardware_gate_status",
    "run_status",
    "halt_reason",
    "finding",
    "register_address",
    "volts_per_count",
    "read_order",
    "records",
    "complete_all14",
    "environment",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": "open_duck_x5.voltage_diagnostic.v1" },
    "backend": { "enum": ["mock", "serial"] },
    "informational_only": { "type": "boolean" },
    "review_status": { "enum": ["INFORMATIONAL_ONLY", "REVIEW_REQUIRED"] },
    "hardware_gate_status": { "const": "NOT_ADVANCED_DIAGNOSTIC_ONLY" },
    "run_status": { "enum": ["COMPLETE", "HALTED"] },
    "halt_reason": { "type": ["string", "null"] },
    "finding": {
      "enum": [
        "incomplete_transport",
        "all_servos_input_voltage_error",
        "mixed_input_voltage_error",
        "no_input_voltage_error"
      ]
    },
    "register_address": { "const": 62 },
    "volts_per_count": { "const": 0.1 },
    "read_order": {
      "const": [20, 21, 22, 23, 24, 30, 31, 32, 33, 10, 11, 12, 14, 13]
    },
    "records": {
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "wire_index",
          "logical_index",
          "servo_id",
          "register_address",
          "response_status",
          "device_status_raw",
          "input_voltage_error",
          "voltage_raw",
          "present_voltage_v",
          "response_length",
          "round_trip_ms"
        ],
        "properties": {
          "wire_index": { "type": "integer", "minimum": 0, "maximum": 13 },
          "logical_index": { "type": "integer", "minimum": 0, "maximum": 13 },
          "servo_id": { "enum": [20, 21, 22, 23, 24, 30, 31, 32, 33, 10, 11, 12, 13, 14] },
          "register_address": { "const": 62 },
          "response_status": {
            "enum": ["ok", "timeout", "crc", "partial", "device", "unexpected_id", "io"]
          },
          "device_status_raw": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
          "input_voltage_error": { "type": "boolean" },
          "voltage_raw": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
          "present_voltage_v": { "type": ["number", "null"], "minimum": 0, "maximum": 25.5 },
          "response_length": { "type": "integer", "minimum": 0 },
          "round_trip_ms": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "complete_all14": { "type": "boolean" },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform",
        "device",
        "baudrate",
        "timeout_ms",
        "repository_commit",
        "hardware_authorized",
        "suspended_or_benched"
      ],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "baudrate": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "number", "exclusiveMinimum": 0 },
        "repository_commit": { "type": "string", "minLength": 1 },
        "hardware_authorized": { "type": "boolean" },
        "suspended_or_benched": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "torque_enable_requested",
        "goal_position_write_count",
        "initial_torque_off_status",
        "final_torque_off_status"
      ],
      "properties": {
        "torque_enable_requested": { "const": false },
        "goal_position_write_count": { "const": 0 },
        "initial_torque_off_status": {
          "enum": ["ok", "timeout", "crc", "partial", "device", "unexpected_id", "io"]
        },
        "final_torque_off_status": {
          "enum": ["ok", "timeout", "crc", "partial", "device", "unexpected_id", "io"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
