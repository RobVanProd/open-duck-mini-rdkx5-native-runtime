{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-duck-x5/voltage-limit-configuration.schema.json",
  "title": "Open Duck X5 guarded maximum-voltage alarm configuration",
  "type": "object",
  "required": [
    "schema_version",
    "backend",
    "informational_only",
    "review_status",
    "hardware_gate_status",
    "run_status",
    "halt_reason",
    "finding",
    "read_order",
    "canary_servo_id",
    "volts_per_count",
    "expected_initial",
    "target",
    "preflight",
    "updates",
    "final_records",
    "journal",
    "environment",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": "open_duck_x5.voltage_limit_configuration.v1" },
    "backend": { "enum": ["mock", "serial"] },
    "informational_only": { "type": "boolean" },
    "review_status": { "enum": ["INFORMATIONAL_ONLY", "REVIEW_REQUIRED"] },
    "hardware_gate_status": { "const": "NOT_ADVANCED_CONFIGURATION_ONLY" },
    "run_status": { "enum": ["COMPLETE", "HALTED"] },
    "halt_reason": { "type": ["string", "null"] },
    "finding": {
      "enum": [
        "configuration_not_started",
        "already_configured",
        "preflight_mismatch",
        "configured_all14",
        "final_verification_failed",
        "configuration_halted",
        "configuration_exception",
        "emergency_relock_failed",
        "final_torque_off_failed"
      ]
    },
    "read_order": {
      "const": [20, 21, 22, 23, 24, 30, 31, 32, 33, 10, 11, 12, 14, 13]
    },
    "canary_servo_id": { "const": 20 },
    "volts_per_count": { "const": 0.1 },
    "expected_initial": { "$ref": "#/$defs/expectedInitial" },
    "target": { "$ref": "#/$defs/target" },
    "preflight": {
      "type": "array",
      "maxItems": 14,
      "items": { "$ref": "#/$defs/limits" }
    },
    "updates": {
      "type": "array",
      "maxItems": 14,
      "items": { "$ref": "#/$defs/update" }
    },
    "final_records": {
      "type": "array",
      "maxItems": 14,
      "items": { "$ref": "#/$defs/update" }
    },
    "journal": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform",
        "device",
        "baudrate",
        "timeout_ms",
        "repository_commit",
        "hardware_authorized",
        "suspended_or_benched",
        "eeprom_confirmation"
      ],
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "torque_enable_requested",
        "goal_position_write_count",
        "minimum_voltage_write_count",
        "maximum_voltage_write_attempt_count",
        "lock_control_write_attempt_count",
        "initial_torque_off_status",
        "final_torque_off_status",
        "all_known_unlocked_servos_relocked"
      ],
      "properties": {
        "torque_enable_requested": { "const": false },
        "goal_position_write_count": { "const": 0 },
        "minimum_voltage_write_count": { "const": 0 },
        "maximum_voltage_write_attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        },
        "lock_control_write_attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29
        },
        "initial_torque_off_status": { "$ref": "#/$defs/status" },
        "final_torque_off_status": { "$ref": "#/$defs/status" },
        "all_known_unlocked_servos_relocked": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "servoId": {
      "enum": [20, 21, 22, 23, 24, 30, 31, 32, 33, 10, 11, 12, 13, 14]
    },
    "status": {
      "enum": ["ok", "timeout", "crc", "partial", "device", "unexpected_id", "io"]
    },
    "expectedInitial": {
      "type": "object",
      "properties": {
        "max_voltage_raw": { "const": 80 },
        "min_voltage_raw": { "const": 40 }
      },
      "required": ["max_voltage_raw", "min_voltage_raw"],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "max_voltage_raw": { "const": 84 },
        "min_voltage_raw": { "const": 40 }
      },
      "required": ["max_voltage_raw", "min_voltage_raw"],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "servo_id",
        "device_status_raw",
        "max_voltage_raw",
        "min_voltage_raw"
      ],
      "properties": {
        "servo_id": { "$ref": "#/$defs/servoId" },
        "device_status_raw": { "type": "integer", "minimum": 0, "maximum": 255 },
        "max_voltage_raw": { "type": "integer", "minimum": 0, "maximum": 255 },
        "min_voltage_raw": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "additionalProperties": false
    },
    "voltage": {
      "type": "object",
      "required": [
        "servo_id",
        "device_status_raw",
        "voltage_alarm",
        "present_voltage_raw",
        "present_voltage_v"
      ],
      "properties": {
        "servo_id": { "$ref": "#/$defs/servoId" },
        "device_status_raw": { "type": "integer", "minimum": 0, "maximum": 255 },
        "voltage_alarm": { "type": "boolean" },
        "present_voltage_raw": { "type": "integer", "minimum": 0, "maximum": 255 },
        "present_voltage_v": { "type": "number", "minimum": 0, "maximum": 25.5 }
      },
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "required": ["servo_id", "limits", "voltage"],
      "properties": {
        "servo_id": { "$ref": "#/$defs/servoId" },
        "limits": { "$ref": "#/$defs/limits" },
        "voltage": { "$ref": "#/$defs/voltage" }
      },
      "additionalProperties": false
    }
  }
}
