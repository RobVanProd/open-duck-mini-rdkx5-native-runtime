{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-duck-x5/policy-handoff.schema.json",
  "title": "Open Duck X5 policy handoff",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "deployment_clearance_granted",
    "runtime_contract",
    "duck_config",
    "candidate_policy",
    "semantic_compatibility"
  ],
  "properties": {
    "schema_version": { "const": "open_duck_x5.policy_handoff.v1" },
    "contract_id": { "const": "open-duck-mini.best-walk.101x14.v1" },
    "deployment_clearance_granted": { "const": false },
    "runtime_contract": {
      "type": "object",
      "required": [
        "control_frequency_hz",
        "onnx_input",
        "onnx_output",
        "onnx_session",
        "observation_fields",
        "target_quantity_map",
        "actions"
      ],
      "properties": {
        "control_frequency_hz": { "const": 50.0 },
        "onnx_input": {
          "type": "object",
          "properties": {
            "name": { "const": "obs" },
            "shape": { "const": [1, 101] },
            "type": { "const": "tensor(float)" }
          },
          "required": ["name", "shape", "type"]
        },
        "onnx_output": {
          "type": "object",
          "properties": {
            "name": { "const": "continuous_actions" },
            "shape": { "const": [1, 14] },
            "type": { "const": "tensor(float)" }
          },
          "required": ["name", "shape", "type"]
        },
        "onnx_session": {
          "type": "object",
          "properties": {
            "execution_mode": { "const": "ORT_SEQUENTIAL" },
            "graph_optimization_level": { "const": "ORT_ENABLE_ALL" },
            "intra_op_num_threads": { "const": 1 },
            "inter_op_num_threads": { "const": 1 },
            "intra_op_allow_spinning": { "const": false },
            "inter_op_allow_spinning": { "const": false }
          },
          "required": [
            "execution_mode",
            "graph_optimization_level",
            "intra_op_num_threads",
            "inter_op_num_threads",
            "intra_op_allow_spinning",
            "inter_op_allow_spinning"
          ],
          "additionalProperties": false
        },
        "observation_fields": {
          "type": "array",
          "minItems": 101,
          "maxItems": 101
        },
        "target_quantity_map": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        },
        "actions": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14
        }
      },
      "additionalProperties": true
    },
    "semantic_compatibility": {
      "type": "object",
      "required": ["status", "blocks_policy_hardware_gate", "questions"],
      "properties": {
        "status": { "const": "PENDING_EVIDENCE" },
        "blocks_policy_hardware_gate": { "const": true },
        "questions": {
          "type": "array",
          "minItems": 3
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
