[Unit]
Description=Open Duck Mini RDK-X5 deterministic runtime
After=multi-user.target

[Service]
Type=simple
User=sunrise
Group=open-duck-rt
WorkingDirectory=/home/sunrise/open-duck-mini-rdkx5-native-runtime
# Authorization flags are intentionally omitted. Add them only in a transient,
# reviewed override for the one explicitly authorized suspended/benched gate.
ExecStart=/home/sunrise/open-duck-x5-venv/bin/open_duck_x5_runtime --bus serial --require-realtime --rt-cpu 5 --rt-priority 80 --config /home/sunrise/duck_config.json --policy /home/sunrise/BEST_WALK_ONNX_2.onnx --controller f710 --telemetry /home/sunrise/duck_logs/runtime.jsonl
Restart=no
CPUAffinity=5
LimitRTPRIO=90
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
