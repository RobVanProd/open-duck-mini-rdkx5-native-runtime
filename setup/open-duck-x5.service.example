[Unit]
Description=Open Duck Mini RDK-X5 deterministic runtime
After=multi-user.target

[Service]
Type=simple
User=sunrise
Group=open-duck-rt
WorkingDirectory=/home/sunrise/open-duck-mini-rdkx5-native-runtime
# Authorization flags are intentionally omitted. Add them only in a transient,
# reviewed override for the one explicitly authorized suspended/benched gate.
ExecStart=/home/sunrise/open-duck-x5-venv/bin/open_duck_x5_runtime --bus serial --require-realtime --rt-cpu 7 --rt-priority 80 --config /home/sunrise/duck_config.json --policy /home/sunrise/candidate-101.onnx --controller f710 --fixed-command-x 0 --max-active-ticks 600 --max-ticks 900 --telemetry /home/sunrise/duck_logs/runtime.jsonl
Restart=no
# All eight CPUs must be available at process start. The runtime partitions
# background/native workers onto 0-6, then moves only the control thread to 7.
# Pinning the whole service to CPU 7 defeats isolation and is rejected.
CPUAffinity=0 1 2 3 4 5 6 7
LimitRTPRIO=90
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
